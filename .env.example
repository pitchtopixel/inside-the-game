# Copy to .env (git-ignored) and fill in. Never commit real values.

# mock = offline deterministic model (default, free) | foundry = Microsoft Foundry
LLM_PROVIDER=mock

# Microsoft Foundry (when LLM_PROVIDER=foundry). Auth: run `az login` first (no API key needed).
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_MODEL=gpt-4o-mini
# 1 = send agent/workflow traces to the Foundry project's Application Insights (Foundry portal > Tracing)
TRACING=0
# 1 = include prompts and answers in traces (synthetic data; demo only)
TRACING_CONTENT=0

# Mock options (tests): ok | fail | slow | bad_json | hallucinate
MOCK_MODE=ok
MOCK_LATENCY_S=0
